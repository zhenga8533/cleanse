{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the app's window may call: Cleanse's own commands, and nothing from Tauri's core or any plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-folders",
    "allow-pick-folders",
    "allow-remove-folder",
    "allow-scan",
    "allow-cancel",
    "allow-summary",
    "allow-candidates",
    "allow-explain",
    "allow-folder",
    "allow-clean",
    "allow-quarantined",
    "allow-restore",
    "allow-purge",
    "allow-history",
    "allow-finish",
    "allow-settings",
    "allow-rules"
  ]
}
